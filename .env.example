# 공공데이터포털(data.go.kr) 일반 인증키 — Decoding 키를 넣는다.
# 실제 값은 .env.local 에만 넣고 커밋하지 않는다. 사용자가 직접 입력한다.
# 사용처: 수집 워커(병·의원 15000736, 약국 15000576, 특일 정보), scripts/api-verification
DATA_GO_KR_KEY=

# Supabase 접속 문자열. 로컬(.env.local)은 dev의 Session pooler(5432), Vercel·Actions는 Transaction pooler(6543).
DATABASE_URL=

# 워커 → 웹 페이지 갱신 요청(GitHub Secrets와 Vercel에 같은 값). 로컬에서는 비워 둬도 된다.
# WEB_BASE_URL은 우리 웹 주소만(https://findmedi.co.kr 또는 *.vercel.app). 다른 주소면 워커가 보내지 않는다. munyeon.kr은 제3자 사이트라 절대 넣지 않는다.
REVALIDATE_SECRET=
WEB_BASE_URL=

# 웹(Vercel 환경변수). 측정 ID와 문의 메일은 공개 값이다.
# NEXT_PUBLIC_SITE_URL=https://findmedi.co.kr (Vercel 운영). 비우면 미리보기는 자기 배포 주소, 그 밖에는 https://findmedi.co.kr.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CONTACT_EMAIL=
NAVER_SITE_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
